{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build test",
            "command": "gcc",
            "args": [
                "-g",
                "${workspaceFolder}/src/test.c",
                "${workspaceFolder}/src/Cockpit/cockpit_main.c",
                "${workspaceFolder}/src/Cockpit/cockpit_ui.c",
                "${workspaceFolder}/src/Cockpit/cockpit_layout.c",
                "${workspaceFolder}/src/FMC/fmc_main.c",
                "${workspaceFolder}/src/FMC/fmc_ui.c",
                "${workspaceFolder}/src/FMC/fmc_data.c",
                "${workspaceFolder}/src/EICAS/eicas_main.c",
                "${workspaceFolder}/src/EICAS/eicas_ui.c",
                "${workspaceFolder}/src/EICAS/eicas_data.c",
                "${workspaceFolder}/src/ND/nd_main.c",
                "${workspaceFolder}/src/ND/nd_ui.c",
                "${workspaceFolder}/src/ND/nd_data.c",
                "${workspaceFolder}/src/PFD/pfd_main.c",
                "${workspaceFolder}/src/PFD/pfd_ui.c",
                "${workspaceFolder}/src/PFD/pfd_data.c",
                "${workspaceFolder}/src/Util/SDL_Util.c",
                "-o",
                "${workspaceFolder}/build/test.exe",
                "-IF:\\msys2\\mingw64\\include",
                "-LF:\\msys2\\mingw64\\lib",
                "-lmingw32",
                "-lSDL2main",
                "-lSDL2",
                "-lSDL2_gfx",
                "-lSDL2_ttf",
                "-lSDL2_image",
                "-lws2_32"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile the current test entry"
        },
        {
            "type": "shell",
            "label": "run test",
            "command": "${workspaceFolder}/build/test.exe",
            "dependsOn": [
                "build test"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Run the current test entry"
        }
    ]
}
